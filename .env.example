# Deinen TMDB API Read Access Token hier lokal eintragen.
TMDB_READ_TOKEN=

# Kostenloser Schlüssel von https://developers.movieofthenight.com/
# Wird nur serverseitig für verifizierte Titel-, Staffel- und Folgenlinks verwendet.
STREAMING_AVAILABILITY_API_KEY=

# Nur verwenden, wenn der Schlüssel stattdessen von RapidAPI stammt.
STREAMING_AVAILABILITY_RAPID_API_KEY=
